<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_brewery_theme"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ResultadoActivity">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutResultadoRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Animación Lottie de celebración -->
            <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/lottieCelebration"
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:lottie_autoPlay="true"
                app:lottie_fileName="celebration.json"
                app:lottie_loop="true" />

            <!-- Título -->
            <TextView
                android:id="@+id/tvResultadoHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/resultado_titulo"
                android:textColor="@color/accent_light"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- TARJETA CON EL DESGLOSE DE PUNTUACIÓN -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/parchment_bg"
                app:cardCornerRadius="18dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/score_earned_label"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Puntuación destacada -->
                    <TextView
                        android:id="@+id/tvPuntuacionFinal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/primary_dark"
                        android:textSize="40sp"
                        android:textStyle="bold"
                        tools:text="+15 pts" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/divider" />

                    <!-- Aciertos -->
                    <TextView
                        android:id="@+id/tvResumenAciertos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_body"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_check"
                        tools:text="Aciertos: 5 / 5 (+15 pts)" />

                    <!-- Fallos -->
                    <TextView
                        android:id="@+id/tvResumenFallos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:drawablePadding="10dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/text_body"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_cross"
                        tools:text="Fallos: 0 / 5 (-0 pts)" />

                    <!-- Veredicto -->
                    <TextView
                        android:id="@+id/tvMensajeVeredicto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_option_selected"
                        android:gravity="center"
                        android:padding="12dp"
                        android:textColor="@color/primary_dark"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="¡Excelente! Dominas las marcas cerveceras." />

                    <!-- Guardar la partida en el ranking (base de datos) -->
                    <EditText
                        android:id="@+id/etNombreJugador"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:autofillHints="name"
                        android:background="@drawable/bg_option_card"
                        android:hint="@string/hint_nombre_jugador"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="20"
                        android:minHeight="48dp"
                        android:padding="12dp"
                        android:textColor="@color/text_body"
                        android:textColorHint="@color/text_muted"
                        tools:targetApi="o" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardarPuntuacion"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:backgroundTint="@color/primary"
                        android:text="@string/btn_guardar_ranking"
                        android:textColor="@color/white"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_trophy"
                        app:iconGravity="textStart"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- BOTONES DE ACCIÓN INFERIORES -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJugarDeNuevo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/accent"
                android:text="@string/btn_jugar_de_nuevo"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_refresh"
                app:iconGravity="textStart"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerRanking"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_ver_ranking"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSalir"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_salir"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:cornerRadius="14dp"
                app:strokeColor="@color/white" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
